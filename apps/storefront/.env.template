# Publishable API key for the Medusa backend. Required for the storefront to function.
# Learn how to create a publishable key: https://docs.medusajs.com/v2/resources/storefront-development/publishable-api-keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# URL of the Medusa backend API server
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Default region code to use for the storefront
NEXT_PUBLIC_DEFAULT_REGION=dk

# Base URL of the storefront (used for generating absolute URLs)
NEXT_PUBLIC_BASE_URL=https://localhost:8000

# Stripe publishable key for payment processing (optional, only if using Stripe)
# Empty: the checkout does not show Stripe, even if the backend offers it.
NEXT_PUBLIC_STRIPE_KEY=

# Medusa Cloud S3 bucket hostname (optional, only for Medusa Cloud deployments)
MEDUSA_CLOUD_S3_HOSTNAME=

# Medusa Cloud S3 bucket path (optional, only for Medusa Cloud deployments)
MEDUSA_CLOUD_S3_PATHNAME=

# Node environment (development, production, etc.)
NODE_ENV=development

# A Fogyasztobarat widget es jogi dokumentumok (2026-10-05). ALAPBOL KI: amig ki van
# kapcsolva, a kirakat semmilyen hivast nem tesz az admin.fogyasztobarat.hu fele.
# Csak az eles atallaskor `true`.
NEXT_PUBLIC_FOGYASZTOBARAT_ENABLED=false
NEXT_PUBLIC_FOGYASZTOBARAT_ID=JPNFMVH0

# A termek-gyorsitotar uritese arvaltozaskor (kartya 2d22116c): ugyanaz a titok,
# mint a backend STOREFRONT_REVALIDATE_SECRET erteke. URESEN az /api/revalidate
# ut nem letezik (404), es az arvaltozas a kovetkezo telepitesig nem latszik.
STOREFRONT_REVALIDATE_SECRET=

# FE-7 RUM: a Core Web Vitals mintaveteli aranya (0 es 1 kozott) a /api/rum utra.
# Uresen 1 (minden lapletoltes), 0 kikapcsolja. A meres URL nelkul, csak az
# oldaltipussal kerul a naploba ({"rum":1,...} sor).
NEXT_PUBLIC_RUM_ARANY=

# FE-7: a .next/cache meretfigyelese (src/instrumentation.ts). A hatar folott a
# naploba egy "CACHE-MERET-RIASZTAS {...}" sor kerul; a riasztas bekotese infra.
# Alapbol 2048 MB, a meres 15 percenkent.
CACHE_MERET_HATAR_MB=
CACHE_MERET_PERC=
