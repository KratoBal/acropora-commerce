# Runtime configuration for both Medusa services. The stage compose file feeds
# this exact file to the server and to the worker (env_file entries in
# infra/docker-compose.yml), so every value here reaches both.
#
# NOT here, because docker-compose.yml already sets them per service:
# NODE_ENV, MEDUSA_WORKER_MODE, DISABLE_MEDUSA_ADMIN, PORT.
# APP_GIT_SHA is not here either: the Dockerfile sets it from the GIT_SHA build
# argument, and deploy-stage.sh verifies it against the commit afterwards.

# --- Database ---
# The password inside this URL must match POSTGRES_PASSWORD in infra/.env.
# Nothing checks that. On a mismatch postgres starts normally and only the
# backend fails to log in. The database name and the user are fixed by
# docker-compose.yml (both "medusa").
DATABASE_URL=

# --- Allowed origins ---
STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com

# --- Redis ---
# Cache, event bus, workflow engine and locking all read this one URL. Without
# it Medusa falls back to a fake in-memory Redis: it prints that it did and
# keeps running, which is wrong for more than one instance and in worker mode.
REDIS_URL=redis://localhost:6379

# --- Secrets ---
# Replace both before anything other than a local run.
# Local development only. The container entrypoint REFUSES to start with a value
# that is missing, shorter than 32 characters, or a placeholder such as this one
# (src/scripts/verify-auth-secrets.ts): set a long random value per environment.
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# --- Which payment provider plays which role ---
# An unset role is simply not mapped, and the code refuses to guess: guessing
# would mean charging a cash-on-delivery fee to a card payment. So an empty
# value here removes a payment role rather than breaking one.

# Not a choice. Medusa builds this id from pp_${identifier}_${id}, and the code
# exports it as CASH_ON_DELIVERY_PROVIDER_ID. It is historical: every
# cash-on-delivery order ever placed carries it, so it cannot be renamed.
ACROPORA_PP_COD=pp_acropora_cod
# Prepayment by bank transfer (card bb3a6bd5): its own provider, never the
# system one (pay-at-store uses that, and an id belongs to one role only).
ACROPORA_PP_BANK_TRANSFER=pp_acropora_transfer

# The built-in system provider, which the payment module's loader registers
# unconditionally.
ACROPORA_PP_PAY_AT_STORE=pp_system_default

# The card provider: Stripe, pp_stripe_stripe (the only one; Balázs 2026-10-05).
# Leave this EMPTY until STRIPE_API_KEY below is set and the provider is linked
# to the region: a named provider that does not exist would be offered to
# customers.
#   ACROPORA_PP_ONLINE_CARD=pp_stripe_stripe
ACROPORA_PP_ONLINE_CARD=

# --- Stripe (card, Apple Pay, Google Pay) ---
# EMPTY means Stripe is not registered at all, and the other payment methods
# are unaffected. Never commit real values (scripts/scan-secrets.mjs checks the
# sk_ form). The webhook URL to set in the Stripe dashboard is
# <backend>/hooks/payment/stripe_stripe, signed with STRIPE_WEBHOOK_SECRET.
# With a key set, the container REFUSES to start without the webhook secret
# (src/scripts/verify-stripe-webhook-secret.ts).
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# The lock on Stripe for mixed carts (live animals + shipped items): one
# Stripe payment for both orders, captured together at shipment. Exactly
# "true" opens it; empty means a mixed cart is offered no card at all.
ACROPORA_STRIPE_MIXED_CART=

# --- Payment link (an order paid after its card hold was released) ---
# Signs the link to the storefront's "Rendelés fizetése" page: at least 32
# random characters, never committed. EMPTY means no link is sent or accepted.
ACROPORA_PAYMENT_LINK_SECRET=
# The storefront the link opens, without a trailing slash, e.g. the test shop's
# https address. EMPTY means no link is sent.
ACROPORA_STOREFRONT_URL=
# Shared with the storefront: a price change empties its product cache through
# ACROPORA_STOREFRONT_URL/api/revalidate (card 2d22116c). At least 32 random
# characters, never committed. EMPTY means no revalidate is sent.
STOREFRONT_REVALIDATE_SECRET=

# --- Mail templates rendered by the OS (Levélsablonok) ---
# "os": the OS renders every shop mail from its templates; anything else
# (EMPTY by default): the shop's own built-in texts, as before. Flip only after
# the stage run.
ACROPORA_WEBSHOP_MAIL_RENDERER=
# The OS's render endpoint (https://<os-api>/integrations/webshop-mail/render)
# and the service token its guard accepts. Never commit
# a real token.
ACROPORA_OS_MAIL_RENDER_URL=
ACROPORA_OS_MAIL_TOKEN=
# --- The guest's invoice download (V1.1) ---
# The invoice links come from the OS. WEBSHOP_INVOICE_SECRET is the secret shared with the OS (random, 32 characters at least,
# the SAME value as the OS's WEBSHOP_INVOICE_SECRET); ACROPORA_OS_INVOICE_URL is the OS's link endpoint
# (https://<os-api>/integrations/webshop-invoice/link). EITHER EMPTY: the order page answers "not available" (503), never an
# invoice. Never commit a real secret.
WEBSHOP_INVOICE_SECRET=
ACROPORA_OS_INVOICE_URL=
# "on": an order placed on the English storefront gets its mails in English (the
# facts carry locale=en). EMPTY by default: every mail is asked for in Hungarian,
# as before. Turn it on only after the OS has its English words (acropora-os,
# the English dictionary step) merged and deployed, or an English order would get
# a half-English mail. Needs ACROPORA_WEBSHOP_MAIL_RENDERER=os (the shop's own
# built-in texts are Hungarian only).
ACROPORA_WEBSHOP_MAIL_ENGLISH=
# TEST SHOP ONLY: one e-mail address. Every shop mail then goes to THAT address instead of the
# customer, with the original recipient named in the subject and at the top of the body. EMPTY (and
# in production): no redirect, the mail goes to the customer. A value that is set but is not exactly
# one address stops the mail (it is never sent to the real recipient). Set it BEFORE the Gmail
# keys and the ACROPORA_WEBSHOP_MAIL switch, never after.
ACROPORA_WEBSHOP_MAIL_REDIRECT_TO=
# "on": a newsletter sign-up gets its confirmation mail (double opt-in, card d707cf5f), rendered by
# the OS (newsletter-confirm). EMPTY by default: the sign-up is recorded as pending and no mail goes.
# TEST SHOP ONLY until Balázs approves the mail's text and the link's seven days. Needs the mail
# switch, ACROPORA_WEBSHOP_MAIL_RENDERER=os and ACROPORA_STOREFRONT_URL (the link's address).
ACROPORA_NEWSLETTER_CONFIRM_MAIL=
# "on": the "Szólj, ha jön hasonló" sign-up on a sold unique piece's page (V2.4, card 0c1265d2) takes
# sign-ups, and each gets its confirmation mail, rendered by the OS (stock-alert-confirm). EMPTY by
# default: the sign-up answers 403 and the storefront shows no form. TEST SHOP ONLY until Balázs
# approves the consent sentence and the mail's text. The mail needs what the newsletter's needs.
ACROPORA_STOCK_ALERT=

# --- Livestock ---
# Comma-separated ProductType ids (ptyp_...) that count as livestock.
# EMPTY ON PURPOSE today: the stage catalogue has no livestock product type, and
# until it has one, the pickup_only flag on the shipping-attributes record
# produces the same PICKUP_ONLY outcome. An invented id is worse than an empty
# value. When the type is created, read its id in the Medusa admin and set it
# here; no code change is needed.
ACROPORA_LIVESTOCK_PRODUCT_TYPE_IDS=

# --- Shipping option ids: overrides only ---
# Every role already has a default id in
# src/workflows/utils/shipping-option-roles.ts. These variables exist so the
# same code can run against another environment without an edit.
#
# Leave a line commented out unless you are actually overriding it. An empty or
# whitespace-only value is ignored and the default stands: that is enforced in
# resolveShippingOptionRoleBindings, not left to whoever fills this file in.
# The values below are the current defaults, so an uncommented line starts from
# the real id rather than from nothing.
#
#ACROPORA_SO_PICKUP=so_01M0K5AFG6M5PDEKCQYW2FNBQZ
#ACROPORA_SO_GLS_HOME=so_01M0K6P7P1Z9XQQANXE2FRATR7
#ACROPORA_SO_GLS_POINT=so_01M0K6W1873VS64WAPQZM7H8KH
#ACROPORA_SO_GLS_HEAVY_HOME=so_01M0K73C9TZZV3ETP02F66HJVG
#ACROPORA_SO_GLS_HEAVY_POINT=so_01M0K7547Z7DNE7CNA86A2FFJ6
#ACROPORA_SO_FOXPOST=so_01M0K783R7D71AKJXC5D0SQ1SN

# Foxpost Web API credentials; leave all three empty to keep Foxpost unavailable.
FOXPOST_API_USER=
FOXPOST_API_PASSWORD=
FOXPOST_API_KEY=

# --- The public prefix of uploaded images ---
# REQUIRED. The server refuses to start without it (docker-entrypoint.sh).
#
# WHY IT HAS NO DEFAULT: Medusa's local file provider falls back to
# `http://localhost:9000/static` when it is given nothing. That address resolves
# on the server and nowhere else, so the deploy looks healthy, our own screens
# look right, and the CUSTOMER is the only one who sees a broken image. A
# default here would reproduce exactly the fault this variable exists to end.
#
# THE VALUE CARRIES THE `/static` PATH, not just the host: the provider appends
# the file name to this pathname.
#
# NOT THE SAME AS MEDUSA_BACKEND_URL, which is Medusa's own name for the admin
# panel's address. Confusing the two gives back the broken images.
#
# The value below is the LOCAL one. On a server it must be the public address
# of that environment, e.g. https://commerce-stage.acropora.hu/static.
#
# WHERE TO SET IT, measured the hard way on 2026-09-04: in the COMMERCE BACKEND
# application - not in the Acropora OS API, where the name also looks
# meaningful. It was set there once and the shop stayed down for fifteen
# minutes. And in BOTH containers: the server and the worker run from the same
# image, so the check runs in both, and the worker fails silently if it is
# missed.
MEDUSA_FILE_BACKEND_URL=http://localhost:9000/static

# THE ÁSZF DOCUMENT THE BACKEND RECORDS, AND THE GATE ON THE CHECKOUT (audit A4;
# card f6cb0a51). The checkout asks the server to record the customer's acceptance
# (POST /store/carts/:id/aszf-elfogadas); the server writes the time, the version
# and the document itself.
#
# THE SHOP TAKES NO ORDER (no card payment starts, no order is placed) unless all
# three are set: the Fogyasztóbarát switch is "true", and both the Hungarian and
# the English document sources are configured. The terms and the privacy notice
# come from Fogyasztóbarát; the gate checks that their sources are configured, it
# does not hold any text of ours. Set the switch to "true" in the SAME moment as
# the storefront's NEXT_PUBLIC_FOGYASZTOBARAT_ENABLED: the record must say what
# the customer was shown. With it "true" the record names the Fogyasztóbarát
# document, its effective date and the sha256 of its text.
FOGYASZTOBARAT_ENABLED=false
# The shop id of the Hungarian documents; must equal the storefront's
# NEXT_PUBLIC_FOGYASZTOBARAT_ID. Unset means the shop's current id.
FOGYASZTOBARAT_ID_HU=JPNFMVH0
# The English source. EMPTY ON PURPOSE: how Fogyasztóbarát serves the English
# documents (the same id with another key, or a separate id) is not known yet.
# While it is empty the checkout refuses every order. Filling it opens the gate
# but NOT the English record: the record names the Hungarian document, and an
# English acceptance is refused until the record can name the English source.
FOGYASZTOBARAT_ID_EN=
# THE LEGAL GATE MODE (Balázs 2026-11-02): "enforce" (the default; unset, empty or
# anything else) means no order without the Fogyasztóbarát documents, as above.
# "test" lets the TEST shop take orders without Fogyasztóbarát (it answers only
# shop.acropora.hu). Test mode is granted ONLY when ACROPORA_STOREFRONT_URL is set
# and its host is exactly the test shop's (shop-staging.acropora.hu); any other
# address, the live one included, is enforce with a loud log line. TO GO LIVE: delete this variable (or set "enforce") and switch
# Fogyasztóbarát on. Set the storefront's NEXT_PUBLIC_LEGAL_GATE_MODE the same way.
LEGAL_GATE_MODE=
