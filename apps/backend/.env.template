# Runtime configuration for both Medusa services. The stage compose file feeds
# this exact file to the server and to the worker (env_file entries in
# infra/docker-compose.yml), so every value here reaches both.
#
# NOT here, because docker-compose.yml already sets them per service:
# NODE_ENV, MEDUSA_WORKER_MODE, DISABLE_MEDUSA_ADMIN, PORT.
# APP_GIT_SHA is not here either: the Dockerfile sets it from the GIT_SHA build
# argument, and deploy-stage.sh verifies it against the commit afterwards.

# --- Database ---
# The password inside this URL must match POSTGRES_PASSWORD in infra/.env.
# Nothing checks that. On a mismatch postgres starts normally and only the
# backend fails to log in. The database name and the user are fixed by
# docker-compose.yml (both "medusa").
DATABASE_URL=

# --- Allowed origins ---
STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com

# --- Redis ---
# Cache, event bus, workflow engine and locking all read this one URL. Without
# it Medusa falls back to a fake in-memory Redis: it prints that it did and
# keeps running, which is wrong for more than one instance and in worker mode.
REDIS_URL=redis://localhost:6379

# --- Secrets ---
# Replace both before anything other than a local run.
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# --- Which payment provider plays which role ---
# An unset role is simply not mapped, and the code refuses to guess: guessing
# would mean charging a cash-on-delivery fee to a card payment. So an empty
# value here removes a payment role rather than breaking one.

# Not a choice. Medusa builds this id from pp_${identifier}_${id}, and the code
# exports it as CASH_ON_DELIVERY_PROVIDER_ID. It is historical: every
# cash-on-delivery order ever placed carries it, so it cannot be renamed.
ACROPORA_PP_COD=pp_acropora_cod

# The built-in system provider, which the payment module's loader registers
# unconditionally. It is the only other provider that exists today.
ACROPORA_PP_PAY_AT_STORE=pp_system_default

# BLOCKED, not undecided. No SimplePay provider is registered in
# medusa-config.ts yet, so there is no id to write here; naming one that does
# not exist has the same effect as a typo. This is filled in together with the
# SimplePay integration, not before.
ACROPORA_PP_ONLINE_CARD=

# --- Livestock ---
# Comma-separated ProductType ids (ptyp_...) that count as livestock.
# EMPTY ON PURPOSE today: the stage catalogue has no livestock product type, and
# until it has one, the pickup_only flag on the shipping-attributes record
# produces the same PICKUP_ONLY outcome. An invented id is worse than an empty
# value. When the type is created, read its id in the Medusa admin and set it
# here; no code change is needed.
ACROPORA_LIVESTOCK_PRODUCT_TYPE_IDS=

# --- Shipping option ids: overrides only ---
# Every role already has a default id in
# src/workflows/utils/shipping-option-roles.ts. These variables exist so the
# same code can run against another environment without an edit.
#
# Leave a line commented out unless you are actually overriding it. An empty or
# whitespace-only value is ignored and the default stands: that is enforced in
# resolveShippingOptionRoleBindings, not left to whoever fills this file in.
# The values below are the current defaults, so an uncommented line starts from
# the real id rather than from nothing.
#
#ACROPORA_SO_PICKUP=so_01M0K5AFG6M5PDEKCQYW2FNBQZ
#ACROPORA_SO_GLS_HOME=so_01M0K6P7P1Z9XQQANXE2FRATR7
#ACROPORA_SO_GLS_POINT=so_01M0K6W1873VS64WAPQZM7H8KH
#ACROPORA_SO_GLS_HEAVY_HOME=so_01M0K73C9TZZV3ETP02F66HJVG
#ACROPORA_SO_GLS_HEAVY_POINT=so_01M0K7547Z7DNE7CNA86A2FFJ6
#ACROPORA_SO_FOXPOST=so_01M0K783R7D71AKJXC5D0SQ1SN

# Foxpost Web API credentials; leave all three empty to keep Foxpost unavailable.
FOXPOST_API_USER=
FOXPOST_API_PASSWORD=
FOXPOST_API_KEY=
