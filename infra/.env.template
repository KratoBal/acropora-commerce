# A stage compose leiras sajat valtozoi. A tenyleges erteket a hoston
# allo infra/.env fajl adja, ami szandekosan NEM verziokovetett (.gitignore).
#
# A ket Medusa szolgaltatas titkai NEM ide tartoznak: azokat a compose kulon
# env_file bejegyzessel a backend sajat .env fajljabol veszi.
#
# EZ AZ ERTEK KETSZER SZEREPEL, KET KULON FAJLBAN: ugyanennek a jelszonak kell
# allnia az apps/backend/.env fajl DATABASE_URL soraban is. Semmi nem ellenorzi
# a kettot egymashoz. Ha elternek, a postgres rendesen elindul, es csak a
# backend nem tud belepni.
POSTGRES_PASSWORD=

# ============================================================================
# A KIRAKAT (storefront) KET KOTELEZO VALTOZOJA
# ============================================================================
#
# Mind a ketto `:?` alakban all a compose fajlban, tehat ha hianyzik, a compose
# HANGOSAN elhasal. Ez szandekos: egy ures `Host()` szabaly csendben felepulne,
# elindulna, es soha nem illeszkedne semmire -- es senki nem tudna, miert nem
# jon be a lap.

# A kirakat cime. A dontott ertek (acrobot, 2026-09-07):
#   STOREFRONT_HOST=shop-staging.acropora.hu
# Ket okbol ez: a teszt gepen mar all az api-staging.acropora.hu, tehat a minta
# a "-staging" utotag; es a kirakat eles neve egyszer shop.acropora.hu lesz,
# tehat a teszt alak a vegleges nev MELLE all.
#
# A DNS-rekord NEM ennek a fajlnak a dolga: amig a nev nem mutat a gepre, a
# Traefik tanusitvany-keresé is elbukik.
STOREFRONT_HOST=

# A Medusa publikalhato kulcsa. NEM titok (a bongeszobe amugy is kikerul), de
# EPITESI feltetel: a `next build` a Store API-t mar epites kozben hivja, harom
# oldal `generateStaticParams` fuggvenyen keresztul. Nelkule a build a
# kategoria-oldalnal all meg, 400-as valasszal.
MEDUSA_PUBLISHABLE_KEY=
